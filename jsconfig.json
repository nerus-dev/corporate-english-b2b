{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "legacy",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "paths": {
      "gsap/*": [
        "./node_modules/gsap/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/*.js",
    "src/*.d.ts"
  ]
}
